{
  "name": "apadore-brand-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"npm run css:types -- --watch\"",
    "css:types": "hcm \"src/**/*.module.css\"",
    "lint": "eslint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:layers": "node scripts/check-layers.mjs",
    "check": "npm run lint && npm run lint:css && npm run check:layers",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "build": "npm run css:types && npm run check && next build",
    "start": "next start"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-css-modules": "^5.0.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^5"
  }
}
